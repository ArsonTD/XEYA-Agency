# Copia este archivo como .env.local (desarrollo) y rellena los valores.
# En el servidor van en /opt/stacks/xeya/.env. Nunca se suben a git.

# Correo saliente de los formularios (SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Desde qué dirección sale el correo (verificada como remitente en el proveedor) y a cuál llega
CONTACT_FROM=
CONTACT_TO=
